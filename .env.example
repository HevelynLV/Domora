# Modelo do .env.local. Copie para .env.local e preencha os valores.
# Este arquivo vai para o GitHub: nunca coloque valores reais aqui.
# Onde pegar cada valor: README.md, passo 4.

# Endereço do projeto Supabase (Project Settings → Data API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (Project Settings → API Keys → Publishable key, começa com sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço do site, sem barra no fim. Em desenvolvimento, sempre este:
SITE_URL=http://localhost:3000

# Chave secreta: os testes automáticos (passo 1.6) e o servidor do app, só em
# src/lib/supabase/admin.ts (excluir assinante pendente, passo 5.2).
# Pessoal: cada um cria a sua. Na Vercel (Etapa 13) vai uma chave de produção separada.
# Nunca com NEXT_PUBLIC_, nunca no código do navegador, nunca no GitHub.
SUPABASE_SECRET_KEY=
